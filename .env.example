# Backend API URL
VITE_API_URL=http://localhost:5000/api

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/phroneo

# Generate a unique random secret of at least 32 characters.
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters

# Server Port
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Contact form delivery (the recipient can also be changed in Admin > Site settings)
CONTACT_RECIPIENT_EMAIL=izuwatopmann7@gmail.com
# Gmail SMTP uses TLS on port 587. Use a Google App Password; never commit it.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# Provision the first administrator with the guarded script (server-side only).
ADMIN_EMAIL=
ADMIN_PASSWORD=
